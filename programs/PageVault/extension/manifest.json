{
  "manifest_version": 3,
  "name": "PageVault",
  "version": "0.1.0",
  "description": "로그인된 페이지를 주기적으로 읽어 PageVault(로컬 SQLite)에 백업합니다.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["alarms", "tabs", "scripting", "nativeMessaging", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "PageVault",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
