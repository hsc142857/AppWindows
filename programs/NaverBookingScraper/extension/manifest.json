{
  "manifest_version": 3,
  "name": "NaverBookingScraper",
  "version": "0.1.0",
  "description": "네이버 예약 파트너센터의 예약 목록을 주기적으로 읽어 NaverBookingScraper로 보냅니다.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "alarms",
    "tabs",
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://partner.booking.naver.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "NaverBookingScraper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
